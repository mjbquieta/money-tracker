// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
// url      = env("DATABASE_URL")

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
  DELETED
}

enum DefaultCategory {
  BILLS
  FOOD
  TRANSPORT
  SAVINGS
  ENTERTAINMENT
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  username        String           @unique
  status          UserStatus       @default(ACTIVE)
  password        String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  twoFactorSecret    String?  @map("two_factor_secret")
  isTwoFactorEnabled Boolean  @default(false) @map("is_two_factor_enabled")

  settings              Settings?
  budgetPeriods         BudgetPeriod[]
  categories            Category[]
  personalBudgets       PersonalBudget[]
  expenseTemplates      ExpenseTemplate[]
  recurringExpenses     RecurringExpense[]
  refreshTokens         RefreshToken[]
  twoFactorBackupCodes  TwoFactorBackupCode[]

  @@map("users")
}

model Settings {
  id        String    @id @default(uuid())
  currency  String    @default("USD")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model BudgetPeriod {
  id        String    @id @default(uuid())
  name      String? // Optional name like "January 2026" or "First Half Jan"
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  expenseGroups ExpenseGroup[]
  incomes       Income[]

  @@map("budget_periods")
}

model Income {
  id          String    @id @default(uuid())
  name        String // e.g., "Main Job", "Side Business", "Freelance"
  description String?
  amount      Float     @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  budgetPeriodId String       @map("budget_period_id")
  budgetPeriod   BudgetPeriod @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)

  @@map("incomes")
}

model ExpenseGroup {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  budgetPeriodId String       @map("budget_period_id")
  budgetPeriod   BudgetPeriod @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  expenses       Expense[]

  @@map("expense_groups")
}

model Category {
  id              String           @id @default(uuid())
  name            String
  description     String?
  spendingLimit   Float?           @map("spending_limit")
  isDefault       Boolean          @default(false) @map("is_default")
  defaultCategory DefaultCategory? @map("default_category") // Only set for system defaults
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime?        @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  // Relations
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  expenseTemplates  ExpenseTemplate[]
  recurringExpenses RecurringExpense[]

  // Each user can have only one category with the same name
  @@unique([userId, name])
  @@map("categories")
}

model Expense {
  id          String    @id @default(uuid())
  name        String
  description String?
  amount      Float     @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  budgetPeriodId String        @map("budget_period_id")
  budgetPeriod   BudgetPeriod  @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  expenseGroupId String?       @map("expense_group_id")
  expenseGroup   ExpenseGroup? @relation(fields: [expenseGroupId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model PersonalBudget {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  userId String
  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  PersonalBudgetItem[]

  @@map("personal_budgets")
}

model PersonalBudgetItem {
  id          String    @id @default(uuid())
  name        String
  description String?
  amount      Float     @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  personalBudgetId String         @map("personal_budget_id")
  personalBudget   PersonalBudget @relation(fields: [personalBudgetId], references: [id], onDelete: Cascade)

  @@map("personal_budget_items")
}

model ExpenseTemplate {
  id          String    @id @default(uuid())
  name        String
  description String?
  amount      Float     @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expense_templates")
}

model RecurringExpense {
  id                String              @id @default(uuid())
  name              String
  description       String?
  amount            Float               @default(0)
  frequency         RecurrenceFrequency
  startDate         DateTime            @map("start_date")
  endDate           DateTime?           @map("end_date")
  isActive          Boolean             @default(true) @map("is_active")
  lastProcessedDate DateTime?           @map("last_processed_date")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime?           @updatedAt @map("updated_at")
  deletedAt         DateTime?           @map("deleted_at")

  // Relations
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recurring_expenses")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  isRevoked  Boolean   @default(false) @map("is_revoked")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model TwoFactorBackupCode {
  id       String    @id @default(uuid())
  codeHash String    @map("code_hash")
  isUsed   Boolean   @default(false) @map("is_used")
  usedAt   DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}
