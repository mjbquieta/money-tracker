// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
// url      = env("DATABASE_URL")

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
  DELETED
}

enum DefaultCategory {
  BILLS
  FOOD
  TRANSPORT
  SAVINGS
  ENTERTAINMENT
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum DebtType {
  I_OWE
  OWED_TO_ME
}

enum DebtStatus {
  ACTIVE
  SETTLED
  CANCELLED
}

enum VehicleExpenseType {
  FUEL
  MAINTENANCE
  INSURANCE
  PARKING
  TOLL
  ACCESSORIES
  REGISTRATION
  WASH
  PARTICIPATION_FEE
  OTHER
}

enum NotificationType {
  BUDGET_LIMIT_EXCEEDED
  BUDGET_LIMIT_APPROACHING
  GOAL_MILESTONE
  GOAL_COMPLETED
  DEBT_DUE_SOON
  DEBT_OVERDUE
  SYSTEM
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  name               String?
  username           String     @unique
  status             UserStatus @default(ACTIVE)
  password           String
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")
  twoFactorSecret    String?    @map("two_factor_secret")
  isTwoFactorEnabled Boolean    @default(false) @map("is_two_factor_enabled")

  settings             Settings?
  budgetPeriods        BudgetPeriod[]
  categories           Category[]
  personalBudgets      PersonalBudget[]
  expenseTemplates     ExpenseTemplate[]
  recurringExpenses    RecurringExpense[]
  tags                 Tag[]
  financialGoals       FinancialGoal[]
  debts                Debt[]
  refreshTokens        RefreshToken[]
  twoFactorBackupCodes TwoFactorBackupCode[]
  notifications        Notification[]
  vehicles             Vehicle[]

  @@map("users")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  data      Json?
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model Settings {
  id                     String    @id @default(uuid())
  currency               String    @default("USD")
  includeVehicleExpenses Boolean   @default(false) @map("include_vehicle_expenses")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime? @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  // Relations
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model BudgetPeriod {
  id        String    @id @default(uuid())
  name      String? // Optional name like "January 2026" or "First Half Jan"
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  expenseGroups ExpenseGroup[]
  incomes       Income[]

  @@map("budget_periods")
}

model Income {
  id          String    @id @default(uuid())
  name        String // e.g., "Main Job", "Side Business", "Freelance"
  description String?
  amount      Float     @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  budgetPeriodId String       @map("budget_period_id")
  budgetPeriod   BudgetPeriod @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)

  @@map("incomes")
}

model ExpenseGroup {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  budgetPeriodId String       @map("budget_period_id")
  budgetPeriod   BudgetPeriod @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  expenses       Expense[]

  @@map("expense_groups")
}

model Category {
  id              String           @id @default(uuid())
  name            String
  description     String?
  spendingLimit   Float?           @map("spending_limit")
  isDefault       Boolean          @default(false) @map("is_default")
  defaultCategory DefaultCategory? @map("default_category") // Only set for system defaults
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime?        @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  // Relations
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  expenseTemplates  ExpenseTemplate[]
  recurringExpenses RecurringExpense[]

  // Each user can have only one category with the same name
  @@unique([userId, name])
  @@map("categories")
}

model Expense {
  id          String    @id @default(uuid())
  name        String
  description String?
  amount      Float     @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  budgetPeriodId String        @map("budget_period_id")
  budgetPeriod   BudgetPeriod  @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  expenseGroupId String?       @map("expense_group_id")
  expenseGroup   ExpenseGroup? @relation(fields: [expenseGroupId], references: [id], onDelete: SetNull)
  expenseTags    ExpenseTag[]

  @@map("expenses")
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  color     String    @default("#6B7280") // Gray default
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseTags ExpenseTag[]

  // Each user can have only one tag with the same name
  @@unique([userId, name])
  @@map("tags")
}

model ExpenseTag {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  expenseId String  @map("expense_id")
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tagId     String  @map("tag_id")
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([expenseId, tagId])
  @@index([expenseId])
  @@index([tagId])
  @@map("expense_tags")
}

model PersonalBudget {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  userId String
  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  PersonalBudgetItem[]

  @@map("personal_budgets")
}

model PersonalBudgetItem {
  id          String    @id @default(uuid())
  name        String
  description String?
  amount      Float     @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  personalBudgetId String         @map("personal_budget_id")
  personalBudget   PersonalBudget @relation(fields: [personalBudgetId], references: [id], onDelete: Cascade)

  @@map("personal_budget_items")
}

model ExpenseTemplate {
  id          String    @id @default(uuid())
  name        String
  description String?
  amount      Float     @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expense_templates")
}

model RecurringExpense {
  id                String              @id @default(uuid())
  name              String
  description       String?
  amount            Float               @default(0)
  frequency         RecurrenceFrequency
  startDate         DateTime            @map("start_date")
  endDate           DateTime?           @map("end_date")
  isActive          Boolean             @default(true) @map("is_active")
  lastProcessedDate DateTime?           @map("last_processed_date")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime?           @updatedAt @map("updated_at")
  deletedAt         DateTime?           @map("deleted_at")

  // Relations
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recurring_expenses")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  isRevoked  Boolean   @default(false) @map("is_revoked")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  codeHash  String    @map("code_hash")
  isUsed    Boolean   @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model FinancialGoal {
  id            String     @id @default(uuid())
  name          String
  description   String?
  targetAmount  Float      @map("target_amount")
  currentAmount Float      @default(0) @map("current_amount")
  targetDate    DateTime?  @map("target_date")
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime?  @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  // Relations
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@map("financial_goals")
}

model GoalContribution {
  id        String   @id @default(uuid())
  amount    Float
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  goalId String        @map("goal_id")
  goal   FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_contributions")
}

model Debt {
  id           String     @id @default(uuid())
  type         DebtType
  counterparty String
  description  String?
  amount       Float
  paidAmount   Float      @default(0) @map("paid_amount")
  dueDate      DateTime?  @map("due_date")
  status       DebtStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime?  @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  // Relations
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@map("debts")
}

model DebtPayment {
  id        String   @id @default(uuid())
  amount    Float
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  debtId String @map("debt_id")
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@map("debt_payments")
}

model Vehicle {
  id           String    @id @default(uuid())
  name         String // e.g., "My Toyota Camry"
  make         String? // e.g., "Toyota"
  model        String? // e.g., "Camry"
  year         Int?
  licensePlate String?   @map("license_plate")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses VehicleExpense[]

  @@index([userId])
  @@map("vehicles")
}

model VehicleExpense {
  id                String             @id @default(uuid())
  type              VehicleExpenseType
  amount            Float
  description       String?
  date              DateTime           @default(now())
  odometer          Float? // Odometer reading at time of expense
  fuelLiters        Float?             @map("fuel_liters") // Only for FUEL type
  fuelPricePerLiter Float?             @map("fuel_price_per_liter") // Only for FUEL type
  isFullTank        Boolean?           @map("is_full_tank") // Only for FUEL type
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime?          @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")

  // Relations
  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_expenses")
}
